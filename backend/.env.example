# Environment Variables for Taskflow Backend

# Secret Key (set a secure random string in production)
SECRET_KEY=django-insecure-taskflow-dev-secret-key-super-secure

# Toggle between SQLite (False) and PostgreSQL (True)
# Set to True when your PostgreSQL server is running
USE_POSTGRES=False

# PostgreSQL Database Configuration
DB_NAME=todolist_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
